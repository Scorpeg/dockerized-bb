+ * Use OpenSSL's existing mutex/RW-lock fallbacks; keep thread safety. */
+#if defined(__APPLE__) && defined(__ENVIRONMENT_IPHONE_OS_VERSION_MIN_REQUIRED__) && __ENVIRONMENT_IPHONE_OS_VERSION_MIN_REQUIRED__ < 60000
+#define BROKEN_CLANG_ATOMICS
+#endif
